# ─────────────────────────────────────────────────────────────────────────────
# Mcaster1InstallSystem — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Sensitive / credentials ───────────────────────────────────────────────────
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.csr
*.keystore
*.jks
notarization-credentials.json
signing-credentials.json
secrets.json
.env
.env.*
*.env

# ── Build output ──────────────────────────────────────────────────────────────
build/
dist/
studio/build/
runtime/build/
studio/build-qt/
runtime/build-qt/

# Visual Studio build output
windows/x64/
windows/Debug/
windows/Release/
windows/moc_generated/
windows/.vs/

# Qt Creator shadow build dirs
*-build-*/
build-*-*/

# ── CMake artifacts ───────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_CMakeFiles/
*.cmake
!CMakeLists.txt
!*.cmake.in
compile_commands.json

# ── Qt / MOC / UIC / RCC generated files ─────────────────────────────────────
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.pro.user
*.pro.user.*
*.qmlproject.user
.qmake.cache
.qmake.stash
Makefile
Makefile.*
!Makefile.am

# ── Visual Studio files ───────────────────────────────────────────────────────
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
*.VC.db
*.VC.opendb
*.ipch
x64/
Debug/
Release/

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.bak
*.tmp
.clangd/
.clang-tidy
compile_flags.txt

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd

# ── Windows system files ──────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini

# ── Linux system files ────────────────────────────────────────────────────────
*~
.directory

# ── Payload staging (populated at build time, large binaries) ────────────────
scripts/mcaster1/*/payload/
!scripts/mcaster1/*/payload/.keep

# Individual large payload files (keep directory structure, not binaries)
payload/*.app/
payload/*.exe
payload/*.dmg
payload/*.deb
payload/*.rpm
payload/*.AppImage

# ── Distribution outputs ──────────────────────────────────────────────────────
*.dmg
*.deb
*.rpm
*.AppImage
*.exe
*.msi
*.pkg
*.ipa
dist/
releases/

# ── Build scripts: keep .sh and .ps1, exclude generated artifacts ─────────────
# (Keep all scripts — they are source, not artifacts)

# ── Log files ────────────────────────────────────────────────────────────────
*.log
logs/

# ── Package manager caches ────────────────────────────────────────────────────
node_modules/
.npm/
__pycache__/
*.pyc
*.pyo
.Python/

# ── Test artifacts ────────────────────────────────────────────────────────────
/tmp/mcaster1_test_installer/
test-output/
