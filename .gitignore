# ─────────────────────────────────────────────────────────────────────────────
# Mcaster1InstallSystem — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Sensitive / credentials ───────────────────────────────────────────────────
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.csr
*.keystore
*.jks
notarization-credentials.json
signing-credentials.json
secrets.json
.env
.env.*
*.env

# ── Build output directories ──────────────────────────────────────────────────
# CMake build trees (all platforms)
build/
build-win/
build-linux/
build-qt/

# Per-subproject build dirs (caught by above patterns, listed explicitly too)
studio/build/
studio/build-win/
studio/build-linux/
runtime/build/
runtime/build-win/
runtime/build-linux/
cli/build/
cli/build-win/
cli/build-linux/

# Qt Creator shadow build dirs
*-build-*/
build-*-*/

# Visual Studio build output
windows/x64/
windows/Debug/
windows/Release/
windows/moc_generated/
windows/.vs/

# ── Distribution / packaged installers ───────────────────────────────────────
dist/
releases/
*.dmg
*.deb
*.rpm
*.AppImage
*.msi
*.pkg
*.ipa
*.zip

# ── Compiled binaries ─────────────────────────────────────────────────────────
# (source .rc, .ico, .manifest files in windows/res/ ARE tracked — these are build outputs)
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk
*.exp

# ── Staged payload directories (large binaries, regenerated at build time) ────
scripts/payload/
scripts/mcaster1/*/payload/
!scripts/mcaster1/*/payload/.keep

# Example project staging dirs (populated by build backends)
examples/*/tmp/
examples/AcmeWidgets/tmp/

# ── CMake artifacts ───────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_CMakeFiles/
*.cmake
!CMakeLists.txt
!*.cmake.in
compile_commands.json

# ── Qt / MOC / UIC / RCC generated files ─────────────────────────────────────
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.pro.user
*.pro.user.*
*.qmlproject.user
.qmake.cache
.qmake.stash
Makefile
Makefile.*
!Makefile.am

# ── Visual Studio project files ───────────────────────────────────────────────
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
*.VC.db
*.VC.opendb
*.ipch
x64/
Debug/
Release/

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.bak
*.tmp
.clangd/
.cache/
.clang-tidy
compile_flags.txt

# ── Claude Code local session data ────────────────────────────────────────────
.claude/

# ── Generated icon assets (regenerated by scripts/generate-icons.py) ─────────
resources/icons/png/

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
*.app/

# ── Windows system files ──────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini

# ── Linux system files ────────────────────────────────────────────────────────
.directory

# ── Log files ────────────────────────────────────────────────────────────────
*.log
logs/

# ── Package manager / language caches ────────────────────────────────────────
node_modules/
.npm/
__pycache__/
*.pyc
*.pyo
.Python/

# ── Test artifacts ────────────────────────────────────────────────────────────
/tmp/mcaster1_test_installer/
test-output/
