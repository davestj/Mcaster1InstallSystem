format: mis/1

app:
  name:        Acme Widgets
  version:     2.1.0
  publisher:   ACME Corporation
  description: A cross-platform widget toolkit for managing and deploying ACME products.
  url:         "https://www.acme-corp.example.com/widgets"
  support-url: "https://support.acme-corp.example.com"
  identifier:  com.acme-corp.acme-widgets
  icon:        resources/acme-widgets.icns
  license:     LICENSE.txt

defaults:
  install-dir:
    macos:   /Applications/ACME Widgets
    windows: "C:\\Program Files\\ACME Corporation\\Acme Widgets"
    linux:   /opt/acme-widgets
  require-admin:      true
  allow-custom-dir:   true
  launch-after:       true
  create-uninstaller: true

theme:
  banner-image:    resources/banner.png
  sidepanel-image: resources/sidepanel.png
  accent-color:    "#0078d4"
  background:      "#1e1e2e"
  dark-mode: true

app-groups:
  - id:          core-app
    name:        Acme Widgets Application
    description: Main application binaries and runtime.
  - id:          documentation
    name:        Documentation
    description: "User guides, API reference and release notes."
  - id:          samples
    name:        Sample Projects
    description: Example widget configurations and demo data.

prerequisites:
  - id: "d: bash"
    name: ""
  - id: "d: libc6"
    name: ""

components:
  - id:          core
    name:        Core Application (required)
    description: "The main acme-widgets binary, default configuration and shared data files."
    required:    true
    selected:    true
    app-group:   core-app
    files:
      - src: bin/acme-widgets
        dst: "{install-dir}/bin/acme-widgets"
        chmod: +x
        platforms: [macos,  linux]
      - src: bin/acme-widgets.bat
        dst: "{install-dir}/bin/acme-widgets.bat"
        platforms: [windows]
      - src: etc/acme-widgets.conf
        dst: "{install-dir}/etc/acme-widgets.conf"
  - id:          docs
    name:        Documentation
    description: "HTML user guide, API reference and release notes."
    required:    false
    selected:    true
    app-group:   documentation
    depends:     [core]
    files:
      - src: share/acme-widgets/README.txt
        dst: "{install-dir}/share/acme-widgets/README.txt"
      - src: share/acme-widgets/CHANGELOG.txt
        dst: "{install-dir}/share/acme-widgets/CHANGELOG.txt"
  - id:          samples
    name:        Sample Projects
    description: Pre-built widget configurations and example data for learning.
    required:    false
    selected:    false
    app-group:   samples
    depends:     [core]
    files:
      - src: share/acme-widgets/sample.dat
        dst: "{install-dir}/share/acme-widgets/sample.dat"

shortcuts:
  - name:   Acme Widgets
    target: "{install-dir}/bin/acme-widgets"
    type:   app
  - name:   Acme Widgets Documentation
    target: "{install-dir}/share/acme-widgets/README.txt"
    type:   url

registry:
  - hive:  ""
    key:   Software\\ACME Corporation\\Acme Widgets
    value: InstallPath
    data:  "{install-dir}"
    type:  REG_SZ
  - hive:  ""
    key:   Software\\ACME Corporation\\Acme Widgets
    value: Version
    data:  2.1.0
    type:  REG_SZ
  - hive:  ""
    key:   Software\\ACME Corporation\\Acme Widgets\\Preferences
    value: FirstRun
    data:  1
    type:  REG_DWORD

custom-actions:
  - id:      ""
    trigger: after-install
    type:    shell
    command: "ldconfig 2>/dev/null || true"
    platforms: [linux]
  - id:      ""
    trigger: after-install
    type:    shell
    command: "mkdir -p /var/log/acme-widgets && chmod 755 /var/log/acme-widgets"
    platforms: [linux]
  - id:      ""
    trigger: after-install
    type:    shell
    command: "osascript -e 'display notification \"Acme Widgets 2.1.0 installed.\" with title \"Installation Complete\"' 2>/dev/null || true"
    platforms: [macos]

targets:
  - macos
  - windows
  - linux
