# acme-widgets sample data file
# This file demonstrates the widget configuration data format.
# In a production installation, this directory holds live widget state.
#
# Format: widget-id|name|type|version|status|config-key=value,...

acme-clock-widget|ACME Desktop Clock|clock|1.0|active|timezone=America/Chicago,format=24h,show_seconds=true
acme-weather-widget|ACME Weather Widget|weather|2.3|active|location=Dallas+TX,units=imperial,refresh_interval=900
acme-stock-widget|ACME Stock Ticker|finance|1.8|disabled|symbols=ACME+GOOG+MSFT,refresh_interval=60,currency=USD

