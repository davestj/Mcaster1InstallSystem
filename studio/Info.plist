<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Mcaster1 Install Studio</string>

    <key>CFBundleDisplayName</key>
    <string>Mcaster1 Install Studio</string>

    <key>CFBundleIdentifier</key>
    <string>com.mcaster1.installstudio</string>

    <key>CFBundleVersion</key>
    <string>1.0.0</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleExecutable</key>
    <string>Mcaster1InstallStudio</string>

    <key>CFBundleIconFile</key>
    <string>mcaster1.icns</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>M1IS</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025 Mcaster1. All rights reserved.</string>

    <!-- Allow opening .mis project files -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Mcaster1 Install Spec</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mis</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
    </array>

    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.mcaster1.mis</string>
            <key>UTTypeDescription</key>
            <string>Mcaster1 Install Spec</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.yaml</string>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mis</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
