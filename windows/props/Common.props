<?xml version="1.0" encoding="utf-8"?>
<!--
  Common.props — Shared compiler/linker settings for all Mcaster1InstallSystem projects
  ─────────────────────────────────────────────────────────────────────────────
  Imported by every vcxproj AFTER Microsoft.Cpp.props and Qt6.props.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ── Source root: all projects include from the repo root and sub-dirs ── -->
  <PropertyGroup>
    <!-- Two levels up from windows/props/ to project root -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..</RepoRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Common include search paths (relative to solution root) -->
      <AdditionalIncludeDirectories>
        $(RepoRoot)\studio;
        $(RepoRoot)\runtime;
        $(RepoRoot)\backends;
        $(RepoRoot)\manifest;
        $(RepoRoot)\importers;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>

      <!-- C++17 standard -->
      <LanguageStandard>stdcpp17</LanguageStandard>

      <!-- Treat warnings as errors (informational), multi-processor build -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>

      <!-- Windows target: Windows 11+ (0x0A00 = NT 10.0, shared by Win10/Win11) -->
      <PreprocessorDefinitions>
        _WIN32_WINNT=0x0A00;
        WINVER=0x0A00;
        NOMINMAX;
        WIN32_LEAN_AND_MEAN;
        _CRT_SECURE_NO_WARNINGS;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
    </ClCompile>

    <!-- ── Linker: Windows system libraries ──────────────────────────────── -->
    <Link>
      <AdditionalDependencies>
        kernel32.lib;user32.lib;gdi32.lib;winspool.lib;comdlg32.lib;
        advapi32.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;
        odbc32.lib;odbccp32.lib;%(AdditionalDependencies)
      </AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── Debug-specific settings ───────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── Release-specific settings ─────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

</Project>
