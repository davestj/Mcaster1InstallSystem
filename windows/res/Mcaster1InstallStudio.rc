// Mcaster1InstallStudio.rc — Windows resource script
// Version information and application icon

#include <windows.h>

// ── Application Icon ────────────────────────────────────────────────────────
// mcaster1.ico: 7-size ICO (16,24,32,48,64,128,256) generated from mcaster1.svg
// Embedded here so Windows Explorer, taskbar, Start Menu, Alt+Tab all show the icon.
#define IDI_APPICON 1
IDI_APPICON   ICON   "mcaster1.ico"

// ── Version Information ─────────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Mcaster1\0"
      VALUE "FileDescription",  "Mcaster1 Install Studio\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "Mcaster1InstallStudio\0"
      VALUE "LegalCopyright",   "Copyright (C) 2025-2026 Mcaster1\0"
      VALUE "OriginalFilename", "Mcaster1InstallStudio.exe\0"
      VALUE "ProductName",      "Mcaster1 Install Studio\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
