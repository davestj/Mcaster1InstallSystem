// Mcaster1Installer.rc — Windows resource script
// Version information and application icon

#include <windows.h>

// IDI_APPICON   ICON   "mcaster1.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Mcaster1\0"
      VALUE "FileDescription",  "Mcaster1 Installer Runtime Wizard\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "Mcaster1Installer\0"
      VALUE "LegalCopyright",   "Copyright (C) 2025-2026 Mcaster1\0"
      VALUE "OriginalFilename", "Mcaster1Installer.exe\0"
      VALUE "ProductName",      "Mcaster1 Installer\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
